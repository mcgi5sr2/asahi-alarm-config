#!/bin/sh
# Attach the VPN's DNS to the ppp link in systemd-resolved, scoped to the
# university domains. Nothing touches the Wi-Fi/wired profiles, and resolved
# forgets these settings by itself when the ppp interface disappears.
# Only acts on tunnels started with pppd-ipparam = openfortivpn-shef.

# openfortivpn appends its route list to ipparam ("openfortivpn-shef,10.0.0.0/...").
case "$PPP_IPPARAM" in openfortivpn-shef*) ;; *) exit 0 ;; esac

# pppd exports DNS1/DNS2 when pppd-use-peerdns = 1; fall back to the known servers.
servers="${DNS1:-143.167.185.64} ${DNS2:-143.167.185.65}"

resolvectl dns "$PPP_IFACE" $servers
resolvectl domain "$PPP_IFACE" shef.ac.uk '~sheffield.ac.uk'
resolvectl default-route "$PPP_IFACE" no
exit 0
