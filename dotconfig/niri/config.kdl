// Minimal niri config for evaluation (2026-09-07)
// Mirrors the Hyprland/noctalia setup: native scale on eDP-1, noctalia shell,
// Kitty terminal, and the same noctalia launcher/lock binds.

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
    }
    focus-follows-mouse
}

// Real-session output. Native scale = maximum screen estate (the thing you
// liked about Umbriel). Ignored when running nested (winit backend).
output "eDP-1" {
    mode "3024x1890@120"
    scale 1.0
}

layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 3
    }
}

prefer-no-csd

// Shell: bar + notifications + launcher + wallpaper + control center
spawn-at-startup "noctalia" "-d"

screenshot-path "~/Pictures/Screenshots/screenshot-%Y-%m-%d-%H-%M-%S.png"

binds {
    // App launcher + lock: same commands you use under Hyprland
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+L     { spawn "noctalia" "msg" "session" "lock"; }

    Mod+Return { spawn "kitty"; }
    Mod+Q      { close-window; }

    // niri help overlay — handy while learning the scrollable layout
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Focus / move within the scrollable row of columns
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }

    // Workspaces (vertical in niri)
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }

    // Column sizing
    Mod+R           { switch-preset-column-width; }
    Mod+F           { maximize-column; }
    Mod+Shift+F     { fullscreen-window; }
    Mod+Comma       { consume-window-into-column; }
    Mod+Period      { expel-window-from-column; }
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }

    Print { screenshot; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}

// noctalia theme colors (regenerated by noctalia when a palette is applied)
include "noctalia.kdl"
