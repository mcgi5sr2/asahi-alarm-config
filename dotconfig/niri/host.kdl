// Per-machine input + output config, included from config.kdl.
// This machine: Asahi Linux MacBook (Apple Silicon), hostname s-mbp-Asahi.
// Facts confirmed live via `niri msg outputs` on 2026-09-12.
// For other machines see dotconfig/niri/hosts/ — copy the matching one here.

input {
    keyboard {
        xkb {
            layout "gb"
        }
    }
    touchpad {
        tap
    }
    focus-follows-mouse
}

// Single internal Retina panel. Mode pinned to the exact string from
// `niri msg outputs` (also the preferred mode). Native scale 1.0 gives
// maximum logical desktop space on the 3024x1890 panel.
output "eDP-1" {
    mode "3024x1890@120.000"
    scale 1.0
}
